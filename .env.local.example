# =============================================================================
# REQUIRED — the app won't start without these.
# =============================================================================

# MySQL 8.0+ / MariaDB 10.6+ connection (Hostinger: hPanel → Databases → MySQL).
# URL-encode special characters in the password (# → %23, @ → %40, / → %2F).
# Tables are created/updated automatically on server start (db/mysql/migrations).
DATABASE_URL=mysql://DBUSER:DBPASS@localhost:3306/DBNAME
# Max pooled connections (shared hosting usually allows ~10–25 per user).
DATABASE_POOL_MAX=5

# WhatsApp token encryption (64 hex chars = 32 bytes).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
# When migrating data from another install, use THAT install's key.
ENCRYPTION_KEY=

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Several apps: comma-separate their secrets. See docs/multi-waba.md.
META_APP_SECRET=

# Canonical public URL (scheme + host, no trailing slash). Used for auth
# email links, public file URLs and links generated by cron jobs.
NEXT_PUBLIC_SITE_URL=https://msg.example.com

# Where uploaded files (chat media, avatars) are stored. Must be OUTSIDE the
# deployed app directory so redeploys don't wipe it.
STORAGE_DIR=/home/USER/wacrm-storage

# =============================================================================
# CRON — secrets the scheduler sends as `Authorization: Bearer <secret>`
# =============================================================================
# Automations / flow timeouts:   GET /api/automations/cron  (every minute)
AUTOMATION_CRON_SECRET=
# Scheduled broadcasts:          GET /api/broadcasts/cron   (every minute)
BROADCAST_CRON_SECRET=

# =============================================================================
# RECOMMENDED / OPTIONAL
# =============================================================================
# UI language: en | ko | pt | es. Inlined at build time — rebuild after changing.
NEXT_PUBLIC_APP_LOCALE=en
# Default country for phone numbers in contact imports (ISO 3166-1 alpha-2).
NEXT_PUBLIC_IMPORT_DEFAULT_COUNTRY=IN
# Product name used in auth emails.
APP_NAME=Shraddha Message

# Auth emails (signup confirmation, password reset, invites).
# Without SMTP_URL the links are printed to the server log.
#   SMTP_URL=smtps://user%40domain.com:password@smtp.hostinger.com:465
#   SMTP_FROM="Shraddha Message <no-reply@domain.com>"
SMTP_URL=
SMTP_FROM=
# Require email confirmation before first login (needs SMTP_URL).
AUTH_REQUIRE_EMAIL_CONFIRMATION=false
# Local http development only: allow the session cookie without HTTPS.
AUTH_INSECURE_COOKIES=false

# Meta App ID (template media uploads via the resumable upload API).
META_APP_ID=
# Set to true to validate template submissions without calling Meta.
WHATSAPP_TEMPLATES_DRY_RUN=false

# Set to true to skip running DB migrations on server start.
SKIP_DB_MIGRATE=false
