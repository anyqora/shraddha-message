# MySQL connection (Hostinger: Databases -> MySQL; host is usually localhost from the web app)
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DBNAME
DATABASE_POOL_MAX=5
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Secret the cron URL must send (header x-cron-secret or ?key=)
CRON_SECRET=
# Public URL of the app
APP_URL=https://msg.shrddhaconsultancypro.in
APP_NAME=Shraddha Message
